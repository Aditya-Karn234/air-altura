PORT=5000

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=AUTH_DB
DB_DIALECT=mysql

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY=24h

FLIGHTS_SERVICE=http://localhost:3000
BOOKING_SERVICE=http://localhost:4000

# Local Redis (host+port) OR managed Redis URL (e.g. Railway/Upstash)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://default:password@host:port

SALT_ROUNDS=10

# Set to your Vercel frontend URL in production to restrict CORS
ALLOWED_ORIGIN=https://your-app.vercel.app
